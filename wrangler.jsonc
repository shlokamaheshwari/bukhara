{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bukhara",
  "main": "worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Both Durable Object classes are declared as bindings on the Worker.
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "AUTH", "class_name": "AuthDO" }
    ]
  },

  // Every new DO class needs a migration entry on first deploy.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO", "AuthDO"]
    }
  ],

  // Public vars only. Real secrets (TOKEN_SECRET, INVITE_CODE) are set via
  // `npx wrangler secret put TOKEN_SECRET` and never live in this file.
  "vars": {
    "PLACEHOLDER": "see README"
  },

  "observability": {
    "enabled": true
  }
}
